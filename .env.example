# TVS Credit Smart Lending Hub — Environment Variables Template
# Copy this file to .env.local and fill in your real credentials.
# NEVER put real secrets in this file. Only NEXT_PUBLIC_* values reach the browser —
# API keys and service credentials must never use that prefix.

# ==========================================
# 1. CORE APPLICATION CONFIGURATION
# ==========================================
# Used to build invite / password-reset links (must match Supabase Auth → URL Configuration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 2. SUPABASE (Postgres + Auth) — Mumbai region
# Found in: Supabase Project Settings -> API & Database
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Required for staff role administration (invites, role changes).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ==========================================
# 3. STAFF RBAC — single administrator
# ==========================================
# Create / transfer the admin:  npx tsx scripts/create-admin.ts admin@yourco.com "Full Name"
# Optional: fixed admin password for the script (otherwise a random one is printed once)
# ADMIN_PASSWORD=

# ==========================================
# 4. TWILIO (SMS / WhatsApp notifications — Phase 6)
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# ==========================================
# 5. GEOSPATIAL & SATELLITE APIS
# ==========================================
# Copernicus Data Space Ecosystem (Sentinel-2 L2A) — dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret
# NASA POWER & Open-Meteo need no key

# ==========================================
# 6. UPSTASH REDIS (Cache, Rate Limiting)
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ==========================================
# 7. UPSTASH QSTASH (Async Job Queue)
# ==========================================
QSTASH_TOKEN=your_qstash_token
# Required in production: webhooks to /api/queue/process are rejected without valid signatures
QSTASH_CURRENT_SIGNING_KEY=your_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# ==========================================
# 8. PII ENCRYPTION (AES-256-GCM) — required in production
# ==========================================

# ==========================================
# 9. ASSISTANT & VERNACULAR AI (TVS Sahayak)
# ==========================================
# Google Gemini API key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default: gemini-2.5-flash, auto-fallback to gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_INFERENCE_PIPELINE_ID=your_pipeline_id

# ==========================================
# 10. DIGITAL PUBLIC INFRASTRUCTURE / SANDBOXES
# ==========================================
SETU_CLIENT_ID=your_setu_sandbox_client_id
SETU_CLIENT_SECRET=your_setu_sandbox_secret
DIGIO_CLIENT_ID=your_digio_client_id

# ==========================================

# ==========================================
# 12. WEB PUSH NOTIFICATIONS (free, VAPID)
# ==========================================
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@yourcompany.com
# Bearer secret for GET/POST /api/cron/emi-reminders (Vercel Cron or manual runs)
CRON_SECRET=a_long_random_string
